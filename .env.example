# Together AI (https://api.together.xyz/settings/api-keys)
# При наличии этой переменной build_default_llm автоматически использует
# Together AI: base_url=https://api.together.xyz/v1, модель DeepSeek-V3 (serverless).
TOGETHER_API_KEY=

# Опционально: переопределить модель Together (любая serverless-модель из каталога).
# LISTING_LLM_MODEL=deepseek-ai/DeepSeek-V3
# LISTING_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo
# LISTING_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Альтернатива — локальный LM Studio / Ollama:
# LISTING_LLM_BASE_URL=http://localhost:1234/v1
# LISTING_LLM_MODEL=qwen2.5-7b-instruct
# LISTING_LLM_API_KEY=local

# Альтернатива — облачный OpenAI:
# OPENAI_API_KEY=sk-...
# LISTING_LLM_MODEL=gpt-4o-mini
